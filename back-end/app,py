import re
import sqlite3
from flask import Flask, request, jsonify

app = Flask(__name__)

# =========================
# CONFIG
# =========================
DATABASE = "scamshield1.db"


# =========================
# INIT DATABASE
# =========================
def init_db():
    conn = sqlite3.connect(DATABASE)
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS reports (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            url TEXT NOT NULL,
            description TEXT NOT NULL
        )
    """)

    conn.commit()
    conn.close()


# =========================
# SCAM ANALYZER ENDPOINT
# =========================
@app.route("/analyze", methods=["POST"])
def analyze():

    data = request.get_json()

    if not data:
        return jsonify({"error": "Invalid JSON"}), 400

    url = data.get("url", "").strip()

    if not url:
        return jsonify({"error": "URL is required"}), 400

    risk_score = 0
    reasons = []

    suspicious_keywords = [
        "earn money fast",
        "registration fee",
        "crypto",
        "investment",
        "guaranteed income",
        "work from home",
        "double your money",
        "telegram job",
        "quick cash",
        "instant profit"
    ]

    url_lower = url.lower()

    # Keyword check
    for keyword in suspicious_keywords:
        if keyword in url_lower:
            risk_score += 20
            reasons.append(f"Suspicious keyword detected: {keyword}")

    # HTTPS check
    if not url.startswith("https://"):
        risk_score += 20
        reasons.append("Website does not use HTTPS")

    # Length check
    if len(url) > 60:
        risk_score += 10
        reasons.append("URL is unusually long")

    # IP address detection
    ip_pattern = r"(https?:\/\/)?(\d{1,3}\.){3}\d{1,3}"
    if re.search(ip_pattern, url):
        risk_score += 25
        reasons.append("URL uses an IP address instead of domain name")

    # Suspicious domains
    suspicious_domains = [".xyz", ".top", ".click", ".loan", ".gq"]

    for domain in suspicious_domains:
        if domain in url_lower:
            risk_score += 15
            reasons.append(f"Suspicious domain detected: {domain}")

    # Hyphen check
    if url.count("-") >= 3:
        risk_score += 10
        reasons.append("Too many hyphens in URL")

    # Number spam check
    if len(re.findall(r"\d", url)) >= 6:
        risk_score += 10
        reasons.append("Too many numbers in URL")

    # Final classification
    if risk_score >= 70:
        status = "Dangerous"
    elif risk_score >= 40:
        status = "Suspicious"
    else:
        status = "Safe"

    return jsonify({
        "url": url,
        "risk_score": risk_score,
        "status": status,
        "reasons": reasons
    })


# =========================
# REPORT SCAM ENDPOINT
# =========================
@app.route("/report", methods=["POST"])
def report_scam():

    data = request.get_json()

    if not data:
        return jsonify({"error": "Invalid JSON"}), 400

    url = data.get("url", "").strip()
    description = data.get("description", "").strip()

    if not url or not description:
        return jsonify({"error": "URL and description are required"}), 400

    conn = sqlite3.connect(DATABASE)
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO reports (url, description)
        VALUES (?, ?)
    """, (url, description))

    conn.commit()
    conn.close()

    return jsonify({
        "message": "Scam report submitted successfully"
    })


# =========================
# GET ALL REPORTS
# =========================
@app.route("/reports", methods=["GET"])
def get_reports():

    conn = sqlite3.connect(DATABASE)
    cursor = conn.cursor()

    cursor.execute("SELECT * FROM reports")
    reports = cursor.fetchall()

    conn.close()

    formatted = []

    for report in reports:
        formatted.append({
            "id": report[0],
            "url": report[1],
            "description": report[2]
        })

    return jsonify(formatted)


# =========================
# START SERVER
# =========================
if __name__ == "__main__":
    init_db()
    app.run(debug=True)